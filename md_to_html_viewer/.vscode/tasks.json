{
  // Opens the file in the active editor tab in md_to_html_viewer with editing support.
  //
  // Setup: Bind in your VS Code keybindings.json to Ctrl+M then Down:
  //   { "key": "ctrl+m down", "command": "workbench.action.tasks.runTask",
  //     "args": "Open in MD Viewer" }
  // (A chord because only Ctrl/Shift/Alt can combine with a key in one press,
  //  so "m" and "down" cannot both be part of a single stroke.)
  //
  // How it works:
  // 1. The script finds the viewer HTML (by probing, not fixed path, so it works
  //    whether you opened the project folder or the monorepo root)
  // 2. Reads your markdown file
  // 3. Embeds the content directly in the HTML (bypassing file:// URL restrictions)
  // 4. Copies vendor files (Mermaid) to the same temp folder
  // 5. Opens the temp HTML with everything self-contained
  //
  // The bootstrap data is embedded directly instead of in a separate .js file,
  // so it works even on file:// URLs where cross-file script loading is blocked.
  //
  // To use from another folder: copy this task to your user-level tasks.json
  // (Ctrl+Shift+P → Tasks: Open User Tasks)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open in MD Viewer",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/open-in-viewer.ps1",
        "${file}",
        "${workspaceFolder}"
      ],
      "presentation": {
        // "silent" keeps the panel shut on success but still surfaces a
        // failure, which "never" would hide.
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
